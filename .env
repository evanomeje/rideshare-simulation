# Server configuration
SERVER_PORT=8080
SERVER_ENV=PROD

# Database configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=postgres        # Change this to your original database name
DB_USER=postgres
DB_PASSWORD=mysecretpassword  # Use your original password

# PostgreSQL specific (should match the above)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword  # Use your original password
POSTGRES_DB=postgres    # Change this to your original database name
